# Example env file for backend (DO NOT commit real secrets)
# Copy this to .env and fill values, then restart the backend: node server.js

# External Amazon rates API (required for real prices)
AMAZON_RATES_API_URL=https://api.example.com/path/to/mandi-rates

# Either provide the key directly here or use Secrets Manager (preferred)
# Option A: put key directly in env (not recommended for production)
AMAZON_API_KEY=YOUR_REAL_API_KEY_HERE

# Option B: store key in AWS Secrets Manager and set the secret ARN/name
# AMAZON_API_KEY_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:amazon/mandi/key-abc123

# (Optional) Header name expected by the external API
# AMAZON_API_KEY_HEADER=x-amazon-api-key

# Server port
PORT=4000

# AWS region used by other services (Polly, S3, etc.)
AWS_REGION=ap-south-1
AWS_REGION=ap-south-1
STEP_FN_ARN=arn:aws:states:REGION:ACCOUNT:stateMachine:KrishiAgent

# (Optional) DynamoDB table to persist scheme applications. If set, backend will store applications here.
APPLICATIONS_TABLE=KrishiApplications

# (Optional) Public JSON feed URL that returns an array of schemes or { schemes: [...] }
SCHEMES_FEED_URL=
