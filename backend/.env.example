# Example env file for backend (DO NOT commit real secrets)
# Copy this to .env and fill values, then restart the backend: node server.js

# Official Government of India Open Data Platform (Agmarknet / DMI)
# Resource: Current Daily Price of Various Commodities from Various Markets (Mandi)
# Register for a free API key at https://data.gov.in (My Account -> API Key)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Commodities-API (Best Overall Coverage for 700+ commodities)
# Get your free access key at https://commodities-api.com
COMMODITIES_API_KEY=your_commodities_api_key_here

# Server port
PORT=4000

# AWS region used by other services (Polly, S3, etc.)
AWS_REGION=ap-south-1
AWS_REGION=ap-south-1
STEP_FN_ARN=arn:aws:states:REGION:ACCOUNT:stateMachine:KrishiAgent

# (Optional) DynamoDB table to persist scheme applications. If set, backend will store applications here.
APPLICATIONS_TABLE=KrishiApplications

# (Optional) Public JSON feed URL that returns an array of schemes or { schemes: [...] }
SCHEMES_FEED_URL=
